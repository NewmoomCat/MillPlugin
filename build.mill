//> using mill-version: 1.1.9
package build
import mill._, javalib._, publish._

object MillPlugin extends JavaModule with PublishModule {
  def repositories = super.repositories() ++ Seq(
      "https://hub.spigotmc.org/nexus/content/groups/public/",
      "https://oss.sonatype.org/content/repositories/snapshots"
  )

  def compileMvnDeps = Seq(
    mvn"org.spigotmc:spigot-api:1.21-R0.1-SNAPSHOT"
  )

  def jvmVersion = "21"

  def artifactName = "MillPlugin"
  def publishVersion = "1.0.0"

  def pomSettings = PomSettings(
    description = "A Bukkit Plugin build by Mill",
    organization = "cn.xinyue-neko.millplugin",
    url = "https://github.com/NewmoomCat/MillPlugin",
    licenses = Seq(License.`GPL-3.0-or-later`),
    versionControl = VersionControl.github("NewmoomCat", "MillPlugin"),
    developers = Seq(
      Developer("XinYueNeko", "XinYueNeko", "3649745663@qq.com")
    )
  )

  override def assembly: Task.Simple[PathRef] = Task {
    val dest = Task.dest / s"${artifactName()}-${publishVersion()}.jar"
    os.copy(super.assembly().path, dest)
    PathRef(dest)
  }
}
